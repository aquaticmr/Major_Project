APP_ENV=development
PROJECT_NAME="FinoAddWise-X"
API_V1_STR=/api/v1
DATABASE_URL=sqlite:///./finoaddwise.db

# Clerk Authentication (Get these from your Clerk dashboard)
CLERK_ISSUER_URL=https://clerk.your-domain.com
CLERK_JWKS_URL=https://clerk.your-domain.com/.well-known/jwks.json
CLERK_SECRET_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Storage & Model Artifacts
MODEL_ARTIFACT_DIR=backend/app/ml/artifacts
DOCUMENT_STORAGE_DIR=storage/documents
CHROMA_PERSIST_DIR=storage/chroma

# LLM & RAG Configuration
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL_NAME=meta-llama/Llama-3-8B-Instruct
EMBEDDING_PROVIDER=fastembed
RAG_HYBRID_ALPHA=0.5

# Evidence Quality Weights (sum = 1.0)
EVIDENCE_ALPHA=0.40
EVIDENCE_BETA=0.35
EVIDENCE_GAMMA=0.25

# Fraud & Trust Thresholds
URL_FRAUD_THRESHOLD=0.70
ENABLE_SYNTHETIC_TRAINING_DATA=true

# Encryption Key for Sensitive Documents (32-byte urlsafe base64 key)
ENCRYPTION_SECRET_KEY=k8Q_Z2-0q1XjF5F6Vv3k8eG2x9zQ4L1m0vW5N8yP3sU=
